# Verified HW-678A / ESP32-S3-WROOM-1-N16R8 baseline inherited from the
# successfully built esp32s3_usb_espnow_bridge project.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# CH343/UART0 remains the build, flash and diagnostic console. The native USB
# connector carries TRILINK/1/3 via TinyUSB CDC, plus a local-only NCM interface.
# Keep all console output on UART0, never on the application data port.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_ESP_TASK_WDT_EN=y

# Exact dependencies are pinned by components/trilink_usb/idf_component.yml.
# Four IN endpoints and two OUT endpoints, no HID/MSC/DFU expansion by default.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=512
CONFIG_TINYUSB_CDC_TX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_EP_BUFSIZE=64
CONFIG_TINYUSB_NET_MODE_NCM=y
CONFIG_TINYUSB_NCM_OUT_NTB_BUFFS_COUNT=2
CONFIG_TINYUSB_NCM_IN_NTB_BUFFS_COUNT=2
CONFIG_TINYUSB_NCM_OUT_NTB_BUFF_MAX_SIZE=2048
CONFIG_TINYUSB_NCM_IN_NTB_BUFF_MAX_SIZE=2048
CONFIG_TINYUSB_DESC_USE_ESPRESSIF_VID=y
CONFIG_TINYUSB_DESC_USE_DEFAULT_PID=n
CONFIG_TINYUSB_DESC_CUSTOM_PID=0x4011
CONFIG_TINYUSB_DESC_BCD_DEVICE=0x0160
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="TriLink development"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="TriLink USB Node"
CONFIG_TINYUSB_DESC_CDC_STRING="TriLink CDC"
CONFIG_TINYUSB_DEBUG_LEVEL=0

# The USB link is local-only: no gateway, DNS, NAT, forwarding or IPv6 route.
# IDF DHCP requires end > start, therefore the smallest explicit pool is .2-.3.
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=2
CONFIG_LWIP_IP_FORWARD=n
CONFIG_LWIP_IPV4_NAPT=n
CONFIG_LWIP_IPV6=n
